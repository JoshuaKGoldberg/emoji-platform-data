{
	"name": "@emoji-platform-data/workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Static export of platform-specific metadata for unicode emojis. 🗝️",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/emoji-platform-data.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "npm@joshuakgoldberg.com"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm run -r build",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:md": "markdownlint \"**/*.md\" \".github/**/*.md\" --rules sentences-per-line",
		"lint:packages": "pnpm dedupe --check",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"tsc": "tsc -b tsconfig.build.json && tsc"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"devDependencies": {
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@types/eslint-plugin-markdown": "2.0.2",
		"@types/node": "24.13.3",
		"cspell": "10.3.3",
		"eslint": "10.11.0",
		"eslint-plugin-jsdoc": "63.3.3",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-markdown": "5.1.0",
		"eslint-plugin-n": "18.3.0",
		"eslint-plugin-package-json": "0.54.0",
		"eslint-plugin-perfectionist": "5.11.1",
		"eslint-plugin-regexp": "3.3.0",
		"eslint-plugin-yml": "3.8.1",
		"husky": "9.1.7",
		"knip": "6.26.0",
		"lint-staged": "17.5.1",
		"markdownlint": "0.41.0",
		"markdownlint-cli": "0.49.0",
		"prettier": "3.9.5",
		"prettier-plugin-curly": "0.4.0",
		"prettier-plugin-packagejson": "3.0.0",
		"prettier-plugin-sh": "0.19.0",
		"sentences-per-line": "0.3.0",
		"tsx": "4.23.0",
		"typescript": "5.9.2",
		"typescript-eslint": "8.41.0"
	},
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=24"
	}
}
