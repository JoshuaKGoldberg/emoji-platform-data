{
	"name": "@emoji-platform-data/workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Static export of platform-specific metadata for unicode emojis. 🗝️",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/emoji-platform-data.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "npm@joshuakgoldberg.com"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm run -r build",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:packages": "pnpm dedupe --check",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"test": "vitest",
		"tsc": "tsc -b tsconfig.build.json && tsc"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"devDependencies": {
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "8.0.3",
		"@types/node": "26.6.2",
		"cspell": "10.3.3",
		"eslint": "10.11.0",
		"eslint-plugin-jsdoc": "64.5.4",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.3.0",
		"eslint-plugin-package-json": "1.10.0",
		"eslint-plugin-perfectionist": "5.12.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "3.8.1",
		"husky": "9.1.7",
		"knip": "6.38.0",
		"lint-staged": "17.5.1",
		"prettier": "3.9.8",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.0.2",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.5",
		"prettier-plugin-sh": "0.19.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"typescript-eslint": "8.70.0",
		"vitest": "5.0.2"
	},
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24"
	}
}
