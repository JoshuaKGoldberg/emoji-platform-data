{
  "name": "@emoji-platform-data/generator",
  "version": "0.12.0",
  "description": "Generates platform-specific metadata for unicode emojis. 🏭",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshuaKGoldberg/emoji-platform-data.git",
    "directory": "packages/generator"
  },
  "license": "MIT",
  "author": {
    "name": "Josh Goldberg",
    "email": "npm@joshuakgoldberg.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "android.json",
    "discord.json",
    "emoji.yml",
    "gnome.json",
    "macos.json",
    "slack.json",
    "wechat.json",
    "windows.json",
    "dist/",
    "lib/dataTypes.d.ts"
  ],
  "scripts": {
    "build": "tsc -b --force && tsdown",
    "refresh:android": "node scripts/refreshAndroid.ts",
    "refresh:discord": "node scripts/refreshDiscord.ts",
    "refresh:gnome": "node scripts/refreshGnome.ts",
    "refresh:macos": "node scripts/refreshMacOS.ts",
    "refresh:slack": "node scripts/refreshSlack.ts",
    "refresh:wechat": "node scripts/refreshWeChat.ts",
    "refresh:windows": "node scripts/refreshWindows.ts",
    "test": "vitest run --config ../../vitest.config.ts --project generator"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "change-case": "^5.4.4",
    "emoji-toolkit": "^11.0.0",
    "emojipedia": "^0.4.0",
    "fast-glob": "^3.3.3",
    "gemoji": "^8.1.0",
    "title-case": "^4.3.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@emoji-platform-data/build": "workspace:^",
    "@types/node": "catalog:",
    "fluemoji": "git+https://github.com/microsoft/fluentui-emoji.git",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
