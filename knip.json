{
	"$schema": "https://unpkg.com/knip@6.37.0/schema.json",
	"ignoreExportsUsedInFile": {
		"interface": true,
		"type": true
	},
	"workspaces": {
		".": {
			"entry": ["test/**/*.test-d.ts"],
			"ignoreDependencies": ["@changesets/cli"]
